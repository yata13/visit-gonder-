# ============================================================
#  Root .gitignore — applies to the whole repository.
#  Each Flutter project also has its own .gitignore inside it.
# ============================================================

# --- Secrets — NEVER commit these -------------------------
# Each developer copies .env.example to .env locally.
.env
*.env
!.env.example

# --- Flutter / Dart build output (regenerated by flutter) --
**/build/
**/.dart_tool/
**/.flutter-plugins-dependencies
**/*.g.dart.tmp

# --- IDE / editor files ------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/settings.json

# --- Logs and temporary files ------------------------------
*.log
*.tmp
.DS_Store
Thumbs.db

# --- Node (in case a web tool is added later) --------------
node_modules/
