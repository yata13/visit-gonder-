# ============================================================
#  Visit Gondar Admin — environment variables (TEMPLATE)
#
#  Setup: copy this file to `.env` in the same folder and fill
#  in the real values. The real `.env` is git-ignored so your
#  keys never end up on GitHub.
#
#  Uses the SAME Supabase project as the tourist app.
#  Get the values from: Supabase Dashboard → Project Settings
#  → API (ask the project owner for access).
# ============================================================

SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
