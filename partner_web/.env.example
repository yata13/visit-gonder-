# Same Supabase project as the Visit Gondar app and admin.
# Copy this file to .env and fill in the two values
# (Supabase -> Project Settings -> API). NEVER commit the .env file.
# The admin's .env works here too (VITE_ or plain SUPABASE_ names).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
